#!/usr/bin/env sh
set -eu

usage() {
  cat <<'USAGE'
Usage: bin/worktree-setup [WORKTREE_PATH]

Runs npm ci in vue and hocuspocus, then prepares the checkout's Rails test DB.
WORKTREE_PATH defaults to the current Git checkout.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

worktree_path="${1:-$(git rev-parse --show-toplevel)}"

test_database_url="$(ruby -I"$worktree_path/lib" -rtest_database_url -e 'puts TestDatabaseUrl.resolve(root: ARGV.fetch(0))' "$worktree_path")"
database_name="${test_database_url##*/}"

(
  cd "$worktree_path/vue"
  npm ci
)

(
  cd "$worktree_path/hocuspocus"
  npm ci
)

(
  cd "$worktree_path"
  RAILS_ENV=test DATABASE_URL="$test_database_url" bin/rails db:prepare
)

cat <<SUMMARY
Set up checkout: $worktree_path
Test database: $database_name
SUMMARY
