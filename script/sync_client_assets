#!/usr/bin/env bash
set -euo pipefail

assets_source_path="${1:-/loomio/vue-build}"
assets_destination_path="${2:-/loomio/public/client3}"
assets_retention_days="${3:-90}"

if [[ ! "$assets_retention_days" =~ ^[0-9]+$ ]]; then
  echo "Asset retention days must be a non-negative integer" >&2
  exit 1
fi

mkdir -p "$assets_destination_path"
# Generated documentation images have stable names and remain valid until the
# optional screenshot command overwrites them, regardless of their age.
find "$assets_destination_path" -path "$assets_destination_path/docs-screenshots" -prune -o -type f -mtime "+$assets_retention_days" -exec rm -f {} +
cp -a "$assets_source_path/." "$assets_destination_path/"
