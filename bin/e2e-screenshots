#!/usr/bin/env bash
set -euo pipefail

# Generate user manual screenshots with the same application setup as bin/playwright.
#
# Usage:
#   bin/e2e-screenshots
#   bin/e2e-screenshots oatmilk_cooperative
#   bin/e2e-screenshots oatmilk_cooperative -g group_overview
#
# Other arguments are passed to `playwright test`.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export SCREENSHOT_DEVICE_SCALE_FACTOR="${SCREENSHOT_DEVICE_SCALE_FACTOR:-2}"
export CANONICAL_HOST="${CANONICAL_HOST:-localhost}"
export CANONICAL_PORT="${CANONICAL_PORT:-${E2E_PORT:-3001}}"
# Screenshot scenarios seed cached translations, so enabling the feature here
# never makes an external translation request.
export TRANSLATE_CREDENTIALS="${TRANSLATE_CREDENTIALS:-cached-screenshot-translations}"
# Push screenshots exercise configured UI without sending web push requests.
export VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY:-screenshot-public-key}"
export VAPID_PRIVATE_KEY="${VAPID_PRIVATE_KEY:-screenshot-private-key}"
export VAPID_SUBJECT="${VAPID_SUBJECT:-mailto:screenshots@example.com}"

exec "$ROOT/bin/playwright" --config playwright.screenshots.config.mjs "$@"
