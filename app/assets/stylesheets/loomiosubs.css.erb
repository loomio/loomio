/*
 *= require vtfy/typography
 *= require vtfy/layout
 */

:root {
  --loomio-primary-color: <%= AppConfig.theme[:primary_color] %>;
  --loomio-primary-text-color: <%= AppConfig.theme[:text_on_primary_color] %>;
  --loomio-accent-color: <%= AppConfig.theme[:accent_color] %>;
  --loomio-accent-text-color: <%= AppConfig.theme[:text_on_accent_color] %>;
  --loomio-dark-color: <%= AppConfig.theme[:brand_colors][:grey700] %>;
}

.btn,
.btn--blue,
.btn--ink,
.btn--accent--raised {
  background: transparent;
  border: 1px solid #bbb;
  border-radius: 4px;
  color: rgba(0, 0, 0, 0.8);
  font-weight: 500;
  padding: 1rem 2rem;
  text-align: center;
  text-decoration: none;
}

.btn--blue,
.btn--ink {
  background-color: var(--loomio-primary-color);
  border-color: transparent;
  color: var(--loomio-primary-text-color);
}

.btn--accent--raised {
  background-color: var(--loomio-accent-color);
  border-color: transparent;
  color: var(--loomio-accent-text-color);
}

.btn--blue:hover,
.btn--blue:focus,
.btn--blue:active,
.btn--ink:hover,
.btn--ink:focus,
.btn--ink:active,
.btn--accent--raised:hover,
.btn--accent--raised:focus,
.btn--accent--raised:active {
  opacity: 0.9;
}

.ribbon-parent {
  overflow: hidden;
  position: relative;
}

.ribbon {
  background: var(--loomio-accent-color);
  color: var(--loomio-accent-text-color);
  margin: 0;
  padding: 0.6em 0;
  position: absolute;
  right: 0;
  top: 0;
  transform: translateX(30%) rotate(45deg);
  transform-origin: top left;
}

.ribbon-grey,
.ribbon-grey::before,
.ribbon-grey::after {
  background: var(--loomio-dark-color) !important;
}

.ribbon::before,
.ribbon::after {
  background: var(--loomio-accent-color);
  content: "";
  height: 100%;
  margin: 0 -1px;
  position: absolute;
  top: 0;
  width: 100%;
}

.ribbon::before {
  right: 100%;
}

.ribbon::after {
  left: 100%;
}

.main--landing section {
  margin-left: auto;
  margin-right: auto;
  padding-left: 20px;
  padding-right: 20px;
}

.main--landing h1,
.main--landing h2 {
  line-height: 120%;
  margin-bottom: 20px;
}

.main--landing h2 {
  font-size: 30px;
}

.main--landing p,
.main--landing li,
.main--landing blockquote {
  line-height: 140%;
}

.main--landing small {
  font-size: 13px;
}

.price-box {
  border: 2px solid var(--loomio-dark-color);
  border-radius: 1.5rem;
  margin: 0 10px 20px;
  padding: 24px 18px;
  width: 320px;
}

.price-box h2 {
  color: #000;
  font-size: 1.875rem;
  font-weight: 400;
  line-height: 2.25rem;
  margin: 0;
}

.price-box.primary {
  border-color: var(--loomio-accent-color);
}

.price-box .invitation {
  font-size: 19px;
  margin-bottom: 20px;
  text-align: center;
}

.ticks--pricing {
  list-style: outside none;
  margin: 0 0 30px;
  padding-left: 1em;
  text-indent: -1em;
}

.ticks--pricing li {
  font-size: 15.5px;
  margin-bottom: 10px;
}

.ticks--pricing li::before {
  content: "✓  ";
}
