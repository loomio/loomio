#!/usr/bin/env bash
set -euo pipefail

# Generate user manual screenshots with the same application setup as bin/e2e.
#
# Usage:
#   bin/e2e-screenshots
#   bin/e2e-screenshots oatmilk_cooperative.js
#   bin/e2e-screenshots oatmilk_cooperative.js --testcase group_overview

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export NIGHTWATCH_DEVICE_SCALE_FACTOR="${NIGHTWATCH_DEVICE_SCALE_FACTOR:-2}"
export NIGHTWATCH_SRC_FOLDERS="tests/e2e/screenshots"
# Screenshot scenarios seed cached translations, so enabling the feature here
# never makes an external translation request.
export TRANSLATE_CREDENTIALS="${TRANSLATE_CREDENTIALS:-cached-screenshot-translations}"

if [[ "${1:-}" == *.js ]]; then
  SPEC_FILE="${1##*/}"
  shift
  exec "$ROOT/bin/e2e" "tests/e2e/screenshots/$SPEC_FILE" --serial "$@"
fi

exec "$ROOT/bin/e2e" --serial "$@"
