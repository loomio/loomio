# Keep this encryption key stable across deployments.
RELAY_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_TOPIC=YOUR_APP_BUNDLE_ID
APNS_KEY_ID=REPLACE_WITH_PRODUCTION_KEY_ID
APNS_SANDBOX_KEY_ID=REPLACE_WITH_SANDBOX_KEY_ID
PROXY_NETWORK=kamal
PROXY_TRUSTED_CIDR=REPLACE_WITH_PROXY_NETWORK_CIDR

# Cloudflare-proxied deployments: all published edge CIDRs, separated by spaces or commas.
# LOOMIO_TRUSTED_EDGE_CIDRS=
